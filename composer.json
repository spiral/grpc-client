{
    "name": "spiral/grpc-client",
    "type": "library",
    "description": "gRPC client",
    "license": "MIT",
    "homepage": "https://spiral.dev",
    "support": {
        "issues": "https://github.com/spiral/grpc-client/issues",
        "source": "https://github.com/spiral/grpc-client",
        "docs": "https://spiral.dev/docs",
        "chat": "https://discord.gg/V6EK4he"
    },
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/spiral"
        }
    ],
    "require": {
        "php": ">=8.2",
        "google/common-protos": "^4.6",
        "google/protobuf": "^4.33.6 || ^5",
        "grpc/grpc": "^1.57",
        "spiral/core": "^3.14",
        "spiral/interceptors": "^3.14"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "buggregator/trap": "^1.16.1",
        "internal/dload": "^1.16.5",
        "llm/skills": "^1.15",
        "roxblnfk/unpoly": "^1.8",
        "spiral/boot": "^3.14",
        "testo/bridge-infection": "^0.1.9",
        "testo/testo": "^0.10.54"
    },
    "conflict": {
        "ext-protobuf": "<4.31"
    },
    "suggest": {
        "ext-grpc": "Required to execute gRPC calls"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Spiral\\Grpc\\Client\\": "src/"
        },
        "files": [
            "src/stub.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\Grpc\\Client\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-update-cmd": [
            "dload get --no-interaction"
        ],
        "proto:generate": "php tests/generate-proto.php",
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix -v --config=vendor-bin/code-style/.php-cs-fixer.dist.php",
        "psalm": "psalm -c vendor-bin/psalm/psalm.xml",
        "psalm:baseline": "psalm -c vendor-bin/psalm/psalm.xml --set-baseline=vendor-bin/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c vendor-bin/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": "testo",
        "test:ci": "testo",
        "infect": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --configuration=infection.json --threads=max"
        ],
        "infect:ci": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --configuration=infection.json --threads=max --no-progress --show-mutations=0 --min-msi=85 --min-covered-msi=85"
        ]
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "vendor-bin"
        }
    }
}
