{
    "name": "spiral/grpc-client",
    "type": "library",
    "description": "gRPC client",
    "license": "MIT",
    "homepage": "https://spiral.dev",
    "support": {
        "issues": "https://github.com/spiral/grpc-client/issues",
        "source": "https://github.com/spiral/grpc-client",
        "docs": "https://spiral.dev/docs",
        "chat": "https://discord.gg/V6EK4he"
    },
    "authors": [
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/spiral"
        }
    ],
    "require": {
        "php": ">=8.2",
        "google/common-protos": "^4.6",
        "google/protobuf": "^4 || ^5",
        "grpc/grpc": "^1.57",
        "spiral/core": "^3.14",
        "spiral/interceptors": "^3.14"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "buggregator/trap": "^1.16.1",
        "internal/dload": "^1.16.5",
        "llm/skills": "^1.15",
        "roxblnfk/unpoly": "^1.8",
        "spiral/boot": "^3.14"
    },
    "suggest": {
        "ext-grpc": "Required to execute gRPC calls"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Spiral\\Grpc\\Client\\": "src/"
        },
        "files": [
            "src/stub.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\Grpc\\Client\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        },
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-update-cmd": [
            "dload get --no-interaction"
        ],
        "proto:generate": "php tests/generate-proto.php",
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "psalm -c tools/psalm/psalm.xml",
        "psalm:baseline": "psalm -c tools/psalm/psalm.xml --set-baseline=tools/psalm/psalm-baseline.xml",
        "psalm:ci": "psalm -c tools/psalm/psalm.xml --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": "testo",
        "test:ci": "testo",
        "infect": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max"
        ]
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "target-directory": "tools",
            "forward-command": true
        }
    }
}
